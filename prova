#!/usr/bin/env python

"""
linuxrouter.py ampliat amb xarxa de servidors i firewall
Corregit:
 - Eliminada referència a variable indefinida defaultIP
 - Assignació d'IP a les interfícies del router feta només via params2 a cada addLink
 - Afegida regla iptables ACCEPT RELATED,ESTABLISHED abans de les regles específiques
 - Comentaris on s'han fet les correccions
"""

from mininet.topo import Topo
from mininet.net import Mininet
from mininet.node import Node
from mininet.log import setLogLevel, info
from mininet.cli import CLI

class LinuxRouter(Node):
    "Node amb IP forwarding actiu"

    def config(self, **params):
        super(LinuxRouter, self).config(**params)
        # Activem l'IP forwarding al router
        self.cmd('sysctl net.ipv4.ip_forward=1')

    def terminate(self):
        self.cmd('sysctl net.ipv4.ip_forward=0')
        super(LinuxRouter, self).terminate()


class NetworkTopo(Topo):
    def build(self):

        # NOTA: NO assignem una IP "per defecte" al node r0 aquí.
        # Assignarem les IPs a cada interfície del router mitjançant params2 a addLink.
        router = self.addNode('r0', cls=LinuxRouter)

        # Switches de departaments
        s1 = self.addSwitch('s1')  # IT
        s2 = self.addSwitch('s2')  # Marketing
        s3 = self.addSwitch('s3')  # HR
        s4 = self.addSwitch('s4')  # Servidors

        # Links: cada addLink amb intfName2 i params2={'ip': 'X.X.X.X/mascara'}
        # Això evita duplicar IPs i evita errors com el NameError que tenies.
        self.addLink(s1, router, intfName2='r0-eth1',
                     params2={'ip': '192.168.1.1/24'})
        self.addLink(s2, router, intfName2='r0-eth2',
                     params2={'ip': '172.16.0.1/12'})
        self.addLink(s3, router, intfName2='r0-eth3',
                     params2={'ip': '10.0.0.1/8'})
        self.addLink(s4, router, intfName2='r0-eth4',
                     params2={'ip': '192.168.100.1/24'})

        # Hosts IT (192.168.1.0/24)
        h1 = self.addHost('h1', ip='192.168.1.100/24',
                          defaultRoute='via 192.168.1.1')
        h2 = self.addHost('h2', ip='192.168.1.101/24',
                          defaultRoute='via 192.168.1.1')
        self.addLink(h1, s1)
        self.addLink(h2, s1)

        # Hosts Marketing (172.16.0.0/12)
        h3 = self.addHost('h3', ip='172.16.0.100/12',
                          defaultRoute='via 172.16.0.1')
        h4 = self.addHost('h4', ip='172.16.0.101/12',
                          defaultRoute='via 172.16.0.1')
        self.addLink(h3, s2)
        self.addLink(h4, s2)

        # Hosts HR (10.0.0.0/8)
        h5 = self.addHost('h5', ip='10.0.0.100/8',
                          defaultRoute='via 10.0.0.1')
        h6 = self.addHost('h6', ip='10.0.0.101/8',
                          defaultRoute='via 10.0.0.1')
        self.addLink(h5, s3)
        self.addLink(h6, s3)

        # Servidors 192.168.100.0/24
        web = self.addHost('webserver', ip='192.168.100.10/24',
                           defaultRoute='via 192.168.100.1')
        db = self.addHost('dbserver', ip='192.168.100.20/24',
                          defaultRoute='via 192.168.100.1')
        fs = self.addHost('fileserver', ip='192.168.100.30/24',
                          defaultRoute='via 192.168.100.1')
        self.addLink(web, s4)
        self.addLink(db, s4)
        self.addLink(fs, s4)


def run():
    topo = NetworkTopo()
    net = Mininet(topo=topo, waitConnected=True)
    net.start()

    router = net['r0']

    # -------- FIREWALL ---------
    
    # 0) Netejar primer
    router.cmd("iptables -F")
    router.cmd("iptables -P FORWARD DROP")   # Política per defecte: DROP
    
    # 1) ARP sempre permès (ha d’anar abans que qualsevol altra)
    router.cmd("iptables -A FORWARD -p arp -j ACCEPT")
    
    # 2) Permetre paquets de retorn
    router.cmd("iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT")
    
    # 3) IT → Servidors (tot permès)
    router.cmd("iptables -A FORWARD -s 192.168.1.0/24 -d 192.168.100.0/24 -j ACCEPT")
    
    # 4) HR → Webserver només (ACCEPT primer, després DROP)
    router.cmd("iptables -A FORWARD -s 10.0.0.0/8 -d 192.168.100.10 -j ACCEPT")
    router.cmd("iptables -A FORWARD -s 10.0.0.0/8 -d 192.168.100.0/24 -j DROP")
    
    # 5) Marketing → cap accés
    router.cmd("iptables -A FORWARD -s 172.16.0.0/12 -d 192.168.100.0/24 -j DROP")

    # Activa el webserver minimal
    net['webserver'].cmd('echo "<h1>Servidor Web Corporatiu</h1>" > /tmp/index.html')
    net['webserver'].cmd('python3 -m http.server 80 --directory /tmp/ > /dev/null 2>&1 &')

    info("\n*** Taula d'encaminament del router:\n")
    info(router.cmd("route -n"))

    info("\n*** Reglas iptables al router (FORWARD):\n")
    info(router.cmd("iptables -L FORWARD -n -v"))

    CLI(net)
    net.stop()


if __name__ == "__main__":
    setLogLevel("info")
    run()
